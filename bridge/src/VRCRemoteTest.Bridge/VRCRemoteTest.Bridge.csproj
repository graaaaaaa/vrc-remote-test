<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET 10 is an LTS release, matching the SDK/runtime available on the dev machine.
    Phase 4a added System.Management (WMI) for VRChat watch worlds flag detection, but
    TargetFramework deliberately stays plain net10.0 rather than switching to
    net10.0-windows: System.Management is referenceable from net10.0 directly, and all
    actual WMI calls are guarded with OperatingSystem.IsWindows() at the call site
    (see VRChat/VrchatProcessMonitor.cs). Verified via a macOS build+test spike and a
    win-x64 self-contained single-file publish spike, both succeeding with the package
    referenced (Codex plan review Phase 4a). Switching to net10.0-windows would only
    suppress CA1416 analyzer warnings, which the runtime guard already makes moot, and
    would add TFM complexity to the test project for no behavioral benefit.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VRCRemoteTest.Bridge</RootNamespace>
    <AssemblyName>VRCRemoteTest.Bridge</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    RuntimeIdentifier/SelfContained/PublishSingleFile are deliberately scoped to
    publish-only (not a plain PropertyGroup), so plain build/test commands still
    produce a normal framework-dependent output the test project can load on any
    dev machine (including macOS). The actual Windows single-file binary is
    produced via the publish command documented in bridge/README.md.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' Or '$(_IsPublishing)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VRCRemoteTest.Bridge.Tests" />
  </ItemGroup>

</Project>
